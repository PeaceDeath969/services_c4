specification {
  element actor { style { shape person } }
  element system
  element container
  element database { style { shape cylinder } }
  element externalSystem

  relationship sync
  relationship async
}

model {
  buyer  = actor "Покупатель"
  seller = actor "Продавец"
  mp = system "Маркетплейс" {
    ui  = container "Сайт и приложение"
    api = container "Шлюз API"
    users    = container "Пользователи"
    catalog  = container "Каталог"
    feed     = container "Лента"
    orders   = container "Заказы"
    payments = container "Платежи"
    notify   = container "Уведомления"
    broker = container "Брокер событий"
    usersDb   = database "Users DB"
    catalogDb = database "Catalog DB"
    feedDb    = database "Feed DB"
    ordersDb  = database "Orders DB"
    payDb     = database "Payments DB"
    notifyDb  = database "Notify DB"
    buyer  .sync ui
    seller .sync ui
    ui .sync api
    api .sync users
    api .sync catalog
    api .sync feed
    api .sync orders
    api .sync payments
    users    .sync usersDb
    catalog  .sync catalogDb
    feed     .sync feedDb
    orders   .sync ordersDb
    payments .sync payDb
    notify   .sync notifyDb
    orders   -[async]-> broker
    payments -[async]-> broker
    catalog  -[async]-> broker
    broker -[async]-> notify
    broker -[async]-> feed
    broker -[async]-> orders
  }
  payProvider = externalSystem "Платежный провайдер"
  msgProvider = externalSystem "Провайдер сообщений"
  mp.payments .sync payProvider
  mp.notify   .sync msgProvider
}

views {
  view containers of mp {
    title "Marketplace containers"
    include buyer
    include seller
    include mp.ui
    include mp.api
    include mp.users
    include mp.catalog
    include mp.feed
    include mp.orders
    include mp.payments
    include mp.notify
    include mp.broker
    include mp.usersDb
    include mp.catalogDb
    include mp.feedDb
    include mp.ordersDb
    include mp.payDb
    include mp.notifyDb
    include payProvider
    include msgProvider
    autoLayout
  }
}